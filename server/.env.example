# Copie para .env (que não vai para o git) e ajuste os valores.
PORT=3000

# Banco local do docker-compose. Na nuvem (Neon), use a connection string do painel.
DATABASE_URL=postgres://stylewalk:stylewalk@localhost:5432/stylewalk
# Use "true" em bancos na nuvem que exigem SSL (ex.: Neon).
DATABASE_SSL=false

# Gere um valor longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=7d

# Access Token de TESTE da aplicação no Mercado Pago (painel do desenvolvedor). Nunca use o de produção.
MP_ACCESS_TOKEN=
